fn main() {
    let base = 12
    let exponent = 2
    print("Cinder functions:")
    print(to_string(power(base, exponent)))
    print(to_string(factorial(5)))
}

fn power(base: i64, exponent: i64) -> i64 {
    if exponent <= 0 {
        return 1
    }
    return base * power(base, exponent - 1)
}

fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}
